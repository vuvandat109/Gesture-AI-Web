# Set these in Render > Web Service > Environment (do not commit real values).
# A non-empty PostgreSQL URL takes precedence over DATABASE_PATH.
DATABASE_URL=
# Use one stable random value across workers and deployments.
SECRET_KEY=
# Set to 1 for Render HTTPS; use 0 for local HTTP.
COOKIE_SECURE=0
# Optional local development path; ignored when DATABASE_URL is set.
# DATABASE_PATH=instance/users.db
# This app reads process environment variables; it does not auto-load .env.
